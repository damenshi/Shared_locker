/* 页面整体布局 */
.container {
  padding: 30rpx;
  background-color: #f8f9fb;
  min-height: 100vh;
}

/* 顶部标题 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
}

/* 卡片布局 */
.card {
  background-color: #fff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.card:active {
  transform: scale(0.98);
}

/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 24rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px solid #f1f1f1;
}

/* 输入行样式 */
.input-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.input-item text {
  width: 160rpx;
  font-size: 28rpx;
  color: #555;
}

.input-item input {
  flex: 1;
  height: 72rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  border: 1px solid #e0e0e0;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.2s;
}

.input-item input:focus {
  border-color: #007aff;
  background: #fff;
  box-shadow: 0 0 10rpx rgba(0, 122, 255, 0.2);
}

/* 按钮样式 - iOS 风格 */
/* 按钮样式 - iOS 风格，字体垂直居中 */
.primary-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #007aff, #005ecc);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  justify-content: center; /* 水平居中 */
  align-items: center;     /* 垂直居中 */
  margin-top: 10rpx;
  transition: all 0.15s ease;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.25);
}

.primary-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

