.container {
  padding: 24rpx 32rpx 40rpx;
  background: #f5f6f8;
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 汇总卡片 */
.summary-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.stat-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.stat-row.last-row {
  border-bottom: none;
}

.stat-period {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  width: 80rpx;
}

.stat-detail {
  flex: 1;
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 退款率颜色 */
.rate-green {
  color: #34c759;
}

.rate-orange {
  color: #ff9500;
}

.rate-red {
  color: #ff3b30;
}

/* 分组标题 */
.section-header {
  display: flex;
  align-items: center;
  margin: 30rpx 0 20rpx;
}

.section-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  padding: 0 20rpx;
}

/* 设备卡片 */
.device-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.device-header {
  margin-bottom: 16rpx;
}

.device-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.device-addr {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.device-stats {
  display: flex;
  justify-content: space-around;
}

.device-stat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.col-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.col-detail {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.col-rate {
  font-size: 32rpx;
  font-weight: 700;
}

.safe-bottom {
  height: 60rpx;
}
