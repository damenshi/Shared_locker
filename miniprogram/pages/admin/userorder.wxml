<view class="container">
  <!-- 如果没有订单 -->
  <block wx:if="{{!loading && orders.length === 0}}">
    <view class="empty">暂无订单</view>
  </block>

  <!-- 有订单时 -->
  <block wx:if="{{orders.length > 0}}">
    <view class="order-list">
      <block wx:for="{{orders}}" wx:key="_id">
        <view class="order-card">
          <view class="order-header">
            <text class="order-id">订单号：{{item._id}}</text>
          </view>

          <view class="order-body">
            <view class="row">
              <text class="label">订单状态</text>
              <text class="status">{{item.status}}</text>
            </view>
            <view class="row">
              <text class="label">手机号</text>
              <text class="value">{{item.phone}}</text>
            </view>
            <view class="row">
              <text class="label">取件码</text>
              <text class="value">{{item.password}}</text>
            </view>
            <view class="row">
              <text class="label">设备编号</text>
              <text class="value">{{item.internalNo}}</text>
            </view>
            <view class="row">
              <text class="label">柜号</text>
              <text class="value">{{item.lockerNo}}</text>
            </view>
            <view class="row">
              <text class="label">设备地址</text>
              <text class="value">{{item.deviceAddress}}</text>
            </view>
            <view class="row">
              <text class="label">用户ID</text>
              <text class="value">{{item.openid}}</text>
            </view>
            <view class="row">
              <text class="label">创建时间</text>
              <text class="value">{{item.createdAtFormatted}}</text>
            </view>
            <view class="row">
              <text class="label">付款金额</text>
              <text class="value">{{item.deposit}}</text>
            </view>
            <block wx:if="{{item.endAtFormatted}}">
              <view class="row">
                <text class="label">结束时间</text>
                <text class="value">{{item.endAtFormatted}}</text>
              </view>
              <view class="row">
                <text class="label">使用时长</text>
                <text class="value">{{item.usageDurationFormatted}}</text>
              </view>
              <view class="row">
                <text class="label">使用费用</text>
                <text class="value">{{item.fee}}</text>
              </view>
              <view class="row">
                <text class="label">可退金额</text>
                <text class="value">{{item.refundAmount}}</text>
              </view>
            </block>
          </view>

          <view class="order-actions">
            <button class="btn refund"
                    bindtap="refund"
                    data-openid="{{item.openid}}"
                    data-id="{{item._id}}">
              退款
            </button>
            <button class="btn finish"
                    bindtap="finishOrder"
                    data-id="{{item._id}}">
              结束订单
            </button>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
