<view class="container">
  <view class="detail-card">
    <view class="section-title">投诉详情</view>

    <view class="info-row">
      <text class="info-label">用户手机号</text>
      <text class="info-value">{{complaint.phone || '未知'}}</text>
    </view>

    <view class="info-row">
      <text class="info-label">投诉类型</text>
      <text class="info-value">{{complaint.typeText}}</text>
    </view>

    <view class="info-row">
      <text class="info-label">当前状态</text>
      <view class="info-value">
        <text class="status-badge status-{{complaint.status}}">{{complaint.statusText}}</text>
      </view>
    </view>

    <view class="info-row" wx:if="{{complaint.orderId}}">
      <text class="info-label">关联订单</text>
      <text class="info-value">{{complaint.orderId}}</text>
    </view>

    <view class="info-row" wx:if="{{complaint.internalNo}}">
      <text class="info-label">设备编号</text>
      <text class="info-value">{{complaint.internalNo}}</text>
    </view>

    <view class="info-row" wx:if="{{complaint.lockerNo}}">
      <text class="info-label">柜门号</text>
      <text class="info-value">{{complaint.lockerNo}}</text>
    </view>

    <view class="info-row">
      <text class="info-label">提交时间</text>
      <text class="info-value">{{complaint.createdAtFormatted}}</text>
    </view>

    <view class="info-row">
      <text class="info-label">投诉内容</text>
    </view>
    <view class="content-box">{{complaint.content}}</view>
  </view>

  <view class="action-section" wx:if="{{complaint.status !== 'resolved' && complaint.status !== 'rejected'}}">
    <view class="action-title">状态操作</view>
    <view class="status-actions">
      <view
        class="status-btn processing"
        wx:if="{{complaint.status === 'pending'}}"
        bindtap="updateStatus"
        data-status="processing"
      >标记为处理中</view>
      <view
        class="status-btn resolved"
        wx:if="{{complaint.status === 'processing'}}"
        bindtap="updateStatus"
        data-status="resolved"
      >标记为已解决</view>
      <view
        class="status-btn rejected"
        wx:if="{{complaint.status === 'processing'}}"
        bindtap="updateStatus"
        data-status="rejected"
      >标记为已拒绝</view>
    </view>
  </view>

  <view class="reply-section">
    <view class="action-title">管理员回复</view>

    <view class="existing-reply" wx:if="{{complaint.reply}}">
      <view class="existing-reply-label">历史回复</view>
      <view class="existing-reply-content">{{complaint.reply}}</view>
      <view class="existing-reply-time" wx:if="{{complaint.handledAtFormatted}}">
        {{complaint.handledAtFormatted}}
      </view>
    </view>

    <textarea
      class="reply-input"
      placeholder="输入回复内容..."
      value="{{replyText}}"
      bindinput="onReplyInput"
    />
    <view class="reply-btn" bindtap="submitReply">提交回复</view>
  </view>
</view>
