<view class="container">
  <block wx:if="{{!loading && devices.length === 0}}">
    <view class="empty">暂无设备</view>
  </block>

  <block wx:if="{{devices.length > 0}}">
    <view class="devices-list">
      <block wx:for="{{devices}}" wx:key="_id">
        <view class="devices-card">
          <view class="devices-header">
            <text class="devices-id">设备编号：{{item.internalNo}}</text>
          </view>

          <view class="devices-body">
            <view class="row">
              <text class="label">设备是否配置</text>
              <text class="value {{item.isConfigured ? 'green-text' : 'red-text'}}">
                {{item.isConfigured ? '是' : '否'}}
              </text>
            </view>

            <view class="row">
              <text class="label">设备是否在线</text>
              <text class="value {{item.isOnline ? 'green-text' : 'red-text'}}">
                {{item.isOnline ? '在线' : '离线'}}
              </text>
            </view>

            <view class="row">
              <text class="label">设备地址</text>
              <text class="value">{{item.deviceAddress}}</text>
            </view>

            <view class="row">
              <text class="label">今日订单</text>
              <text class="value">{{item.todayPaid || 0}}</text>
            </view>

            <!-- <view class="row">
              <text class="label">今日退款订单</text>
              <text class="value">{{item.todayRefunded || 0}}</text>
            </view> -->

            <view class="row">
              <text class="label">本月订单</text>
              <text class="value">{{item.thisMonthPaid || 0}}</text>
            </view>

            <!-- <view class="row">
              <text class="label">本月退款订单</text>
              <text class="value">{{item.thisMonthRefunded || 0}}</text>
            </view> -->

            <view class="row">
              <text class="label">上月订单</text>
              <text class="value">{{item.lastMonthPaid || 0}}</text>
            </view>

            <!-- <view class="row">
              <text class="label">上月退款订单</text>
              <text class="value">{{item.lastMonthRefunded || 0}}</text>
            </view> -->
          </view>

          <!-- ✅ 展开详情 -->
          <view wx:if="{{expandedDeviceId === item.deviceId}}">
            <view class="extra-info">
              <view class="row">
                <text class="label">设备ID</text>
                <text class="value">{{item.deviceId}}</text>
              </view>

              <view class="row">
                <text class="label">屏幕编号</text>
                <text class="value">{{item.screenNo}}</text>
              </view>

              <view class="row">
                <text class="label">设备归属</text>
                <text class="value {{item.appid ? 'green-text' : 'red-text'}}">
                  {{item.miniName || '未设置'}}
                </text>
              </view>

              <view class="row">
                <text class="label">设备锁板数量</text>
                <text class="value">{{item.cabinetCount}}</text>
              </view>

              <view class="row">
                <text class="label">每锁板锁数量</text>
                <text class="value">{{item.doorCount}}</text>
              </view>

              <view class="row">
                <text class="label">收费标准</text>
                <text class="value">{{item.deviceDeposit}}元</text>
              </view>

              <view class="row">
                <text class="label">收费策略</text>
                <text class="value">{{item.unitPrice}}元/小时</text>
              </view>

              <view class="row">
              <text class="label">延时退款</text>
                <text class="value {{item.delayedRefund ? 'green-text' : 'red-text'}}">
                  {{item.delayedRefund ? '是' : '否'}}
                </text>
              </view>
            
              <view class="row">
                <text class="label">创建时间</text>
                <text class="value">{{item.createdAtFormatted}}</text>
              </view>

              <view class="row">
                <text class="label">更新时间</text>
                <text class="value">{{item.updatedAtFormatted}}</text>
              </view>

              <view class="row">
                <text class="label">最后登录时间</text>
                <text class="value">{{item.lastLoginFormatted}}</text>
              </view>
            </view>

            <!-- ✅ 新增操作按钮 -->
            <view class="action-buttons">
              <button class="ios-btn blue"
              data-deviceId="{{item.deviceId}}"
              data-internalNo="{{item.internalNo}}"
              bindtap="showOpenLockerModal">开柜</button>
              <button class="ios-btn orange" data-deviceId="{{item.deviceId}}" bindtap="confirmClearLockers">清柜</button>
              <button class="ios-btn red"
              data-internalNo="{{item.internalNo}}"
              data-cabinetCount="{{item.cabinetCount}}"
              data-doorCount="{{item.doorCount}}"
              bindtap="confirmOpenAllLockers">全开</button>

              <button class="ios-btn purple"
              data-internalNo="{{item.internalNo}}"
              bindtap="showStatusModal">柜门状态</button>

              <button class="ios-btn green"
              data-deviceid="{{item.deviceId}}"
              data-internalno="{{item.internalNo}}"
              bindtap="showAppidModal">归属设置</button>
            </view>
          </view>

          <!-- ✅ 底部展开按钮 -->
          <view class="device-footer">
            <button
              class="detail-btn"
              bindtap="toggleDetail"
              data-deviceid="{{item.deviceId}}"
            >
              {{expandedDeviceId === item.deviceId ? '收起详情' : '设备详情'}}
            </button>
          </view>
        </view>
      </block>
    </view>
  </block>

  <!-- ✅ 打开柜门弹窗 -->
  <view class="modal-mask" wx:if="{{showOpenLocker}}">
    <view class="modal">
      <view class="modal-title">请输入柜门编号</view>
      <input class="modal-input" type="number" placeholder="请输入柜号" bindinput="onLockerNoInput" />
      <view class="modal-buttons">
        <button class="cancel-btn" bindtap="closeModal">取消</button>
        <button class="confirm-btn" bindtap="confirmOpenLocker">确定</button>
      </view>
    </view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showStatusModal}}" bindtap="closeStatusModal">
    <view class="modal">
      <view class="modal-title">设置柜门状态</view>
      
      <view class="modal-content-body">
        <view class="device-tip">当前设备：{{currentInternalNo}}</view>
        <input 
          class="modal-input" 
          type="number" 
          placeholder="请输入柜号 (如: 1)" 
          value="{{statusLockerNo}}"
          bindinput="onStatusLockerInput"
          catchtap="true"
        />
      </view>

      <view class="status-btn-group">
        <button class="status-btn free" catchtap="updateLockerStatus" data-status="free">
          设为空闲
        </button>
        <button class="status-btn occupied" catchtap="updateLockerStatus" data-status="occupied">
          设为占用
        </button>
        <button class="status-btn broken" catchtap="updateLockerStatus" data-status="broken">
          设为故障
        </button>
      </view>

      <view class="modal-buttons" style="margin-top: 20rpx;">
        <button class="cancel-btn" catchtap="closeStatusModal" style="width: 100%;">取消关闭</button>
      </view>
    </view>
  </view>

  <!-- 修改设备归属弹窗 -->
  <view class="modal-mask" wx:if="{{showAppidModal}}" bindtap="closeAppidModal">
    <view class="modal" catchtap="true">
      <view class="modal-title">设置设备归属</view>
      <view class="modal-content-body">
        <view class="device-tip">当前设备：{{currentChangeDeviceName}}</view>
        <picker mode="selector" range="{{appidOptions}}" bindchange="onAppidChange">
          <view class="modal-input picker-value">
            {{selectedAppidIndex !== undefined ? appidOptions[selectedAppidIndex] : '请选择小程序'}}
          </view>
        </picker>
      </view>
      <view class="modal-buttons" style="margin-top: 20rpx;">
        <button class="cancel-btn" catchtap="closeAppidModal">取消</button>
        <button class="confirm-btn" catchtap="confirmChangeAppid">确定</button>
      </view>
    </view>
  </view>