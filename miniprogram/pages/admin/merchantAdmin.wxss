.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 32rpx;
}

.loading-tip,
.empty-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* 限额设置卡片 */
.limits-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e5e7eb;
}

.limit-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.limit-label {
  font-size: 28rpx;
  color: #374151;
  width: 180rpx;
  flex-shrink: 0;
}

.limit-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.limit-unit {
  font-size: 26rpx;
  color: #9ca3af;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.limit-save-btn {
  margin: 8rpx 0 0;
  height: 72rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #1e3a5f;
  color: #fff;
}

.limit-save-btn::after {
  border: none;
}

/* 商户卡片 */
.merchant-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e5e7eb;
}

.merchant-card.active {
  border-color: #f59e0b;
  background: linear-gradient(135deg, #fef3c7 0%, #fff 60%);
}

.merchant-card.restricted {
  border-color: #fca5a5;
}

.merchant-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.badges {
  display: flex;
  gap: 12rpx;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.badge-active {
  background: #fef3c7;
  color: #d97706;
  font-weight: 600;
}

.badge-normal {
  background: #dcfce7;
  color: #16a34a;
}

.badge-restricted {
  background: #fee2e2;
  color: #dc2626;
  font-weight: 600;
}

.merchant-mchid {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.status-reason {
  font-size: 24rpx;
  color: #dc2626;
  background: #fef2f2;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 8rpx;
}

/* 统计区 */
.stats-section {
  margin-top: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
}

.stats-title {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.stat-value.stat-danger {
  color: #dc2626;
}

.stat-limit {
  font-size: 22rpx;
  color: #9ca3af;
  font-weight: 400;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.fail-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #d97706;
  background: #fffbeb;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

/* 自动轮换开关 */
.rotate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.rotate-label {
  font-size: 26rpx;
  color: #374151;
}

.rotate-row switch {
  transform: scale(0.85);
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
}

.action-btn::after {
  border: none;
}

.btn-primary {
  background: #1e3a5f;
  color: #fff;
}

.btn-danger {
  background: #fee2e2;
  color: #dc2626;
}

.btn-success {
  background: #dcfce7;
  color: #16a34a;
}

.btn-disabled {
  background: #f3f4f6;
  color: #9ca3af;
}

.safe-bottom {
  height: 60rpx;
}
