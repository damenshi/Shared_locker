.container {
  padding: 20rpx;
  background: #f5f5f7;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", sans-serif;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 30rpx;
}

.devices-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.devices-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.05);
  padding: 30rpx;
  transition: all 0.2s ease;
}

.devices-card:active {
  transform: scale(0.99);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
}

.devices-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.devices-id {
  color: #333;
  font-size: 28rpx;
}

.free-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: normal;
}

.free-tag.free {
  color: #ff9500;
  background: #fff7e6;
}

.free-tag.paid {
  color: #34c759;
  background: #e8f9eb;
}

.devices-body .row {
  display: flex;
  justify-content: space-between;
  align-items: center; /* ✅ 保证垂直对齐 */
  padding: 16rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.devices-body .row:last-child {
  border-bottom: none;
}

.label {
  color: #666;
  font-size: 26rpx;
  flex: 1;
}

.value {
  color: #333;
  font-size: 26rpx;
  flex-shrink: 0;
  text-align: right;
  min-width: 160rpx; /* ✅ 确保每行右侧宽度一致 */
}

/* ✅ 状态颜色定义 */
.red-text {
  color: #ff3b30; /* iOS 红 */
  font-weight: 500;
}

.green-text {
  color: #34c759; /* iOS 绿 */
  font-weight: 500;
}

.url-link {
  color: #007aff;
  font-weight: 500;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.detail-btn {
  background: #007aff; /* iOS 蓝 */
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 36rpx;
  border-radius: 32rpx;
  border: none;
  outline: none;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.2);
  transition: all 0.2s ease;
}

.detail-btn:active {
  background: #0062cc;
  transform: scale(0.98);
}

.extra-info {
  margin-top: 20rpx;
  padding-top: 10rpx;
  border-top: 1px solid #f0f0f0;
  animation: expand 0.25s ease-out;
}

@keyframes expand {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* === 新增 iOS 操作区 === */
.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 16rpx;
}

.action-buttons .ios-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  border-radius: 16rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  transition: all 0.2s ease;
  min-height: 70rpx;
  line-height: 1.5;
}

.ios-btn:active {
  transform: scale(0.97);
}

.ios-btn.blue {
  background: #007aff;
}

.ios-btn.orange {
  background: #ff9500;
}

.ios-btn.red {
  background: #ff3b30;
}

/* === 弹窗 === */
.modal-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 680rpx; /* ✅ 比原来略宽，视觉更舒展 */
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.2);
  animation: fadeIn 0.25s ease;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: #333;
  margin-bottom: 28rpx;
}

.modal-input {
  width: 100%;
  height: 90rpx; /* ✅ 高度略调大，符合 iOS 输入框手感 */
  border: 1px solid #ddd;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f9f9fb; /* ✅ iOS 浅灰底更自然 */
}

.modal-buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
}

.cancel-btn, .confirm-btn {
  width: 200rpx;
  text-align: center;
  border-radius: 32rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #fff;
}

.cancel-btn {
  background: #ccc;
}

.confirm-btn {
  background: #007aff;
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

