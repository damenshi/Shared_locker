<view class="container">
  <block wx:if="{{!loading && devices.length === 0}}">
    <view class="empty">暂无设备</view>
  </block>

  <block wx:if="{{devices.length > 0}}">
    <view class="devices-list">
      <block wx:for="{{devices}}" wx:key="_id">
        <view class="devices-card">
          <view class="devices-header">
            <text class="devices-id">设备编号：{{item.internalNo}}</text>
          </view>

          <view class="devices-body">
            <view class="row">
              <text class="label">设备是否配置</text>
              <text class="value {{item.isConfigured ? 'green-text' : 'red-text'}}">
                {{item.isConfigured ? '是' : '否'}}
              </text>
            </view>

            <view class="row">
              <text class="label">设备是否在线</text>
              <text class="value {{item.isOnline ? 'green-text' : 'red-text'}}">
                {{item.isOnline ? '在线' : '离线'}}
              </text>
            </view>

            <view class="row">
              <text class="label">设备地址</text>
              <text class="value">{{item.deviceAddress}}</text>
            </view>

            <view class="row">
              <text class="label">今日订单</text>
              <text class="value">{{item.todayPaid || 0}}</text>
            </view>

            <view class="row">
              <text class="label">本月订单</text>
              <text class="value">{{item.thisMonthPaid || 0}}</text>
            </view>

            <view class="row">
              <text class="label">上月订单</text>
              <text class="value">{{item.lastMonthPaid || 0}}</text>
            </view>

          </view>

          <!-- ✅ 展开详情 -->
          <view wx:if="{{expandedDeviceId === item.deviceId}}">
            <view class="extra-info">
              <view class="row">
                <text class="label">屏幕编号</text>
                <text class="value">{{item.screenNo}}</text>
              </view>

              <view class="row">
                <text class="label">设备锁板数量</text>
                <text class="value">{{item.cabinetCount}}</text>
              </view>

              <view class="row">
                <text class="label">每锁板锁数量</text>
                <text class="value">{{item.doorCount}}</text>
              </view>

              <!-- <view class="row">
                <text class="label">收费标准</text>
                <text class="value">{{item.deviceDeposit}}</text>
              </view> -->

              <view class="row">
                <text class="label">创建时间</text>
                <text class="value">{{item.createdAtFormatted}}</text>
              </view>

              <view class="row">
                <text class="label">更新时间</text>
                <text class="value">{{item.updatedAtFormatted}}</text>
              </view>

              <view class="row">
                <text class="label">最后登录时间</text>
                <text class="value">{{item.lastLoginFormatted}}</text>
              </view>
            </view>

            <!-- ✅ 新增操作按钮 -->
            <view class="action-buttons">
              <button class="ios-btn blue" 
              data-deviceId="{{item.deviceId}}"
              data-internalNo="{{item.internalNo}}"  
              bindtap="showOpenLockerModal">开柜</button>
              <!-- <button class="ios-btn orange" data-deviceid="{{item.deviceId}}" bindtap="confirmClearLockers">清柜</button> -->
              <button class="ios-btn red" 
              data-internalNo="{{item.internalNo}}"
              data-cabinetCount="{{item.cabinetCount}}"
              data-doorCount="{{item.doorCount}}"
              bindtap="confirmOpenAllLockers">全开</button>
            </view>
          </view>

          <!-- ✅ 底部展开按钮 -->
          <view class="device-footer">
            <button
              class="detail-btn"
              bindtap="toggleDetail"
              data-deviceid="{{item.deviceId}}"
            >
              {{expandedDeviceId === item.deviceId ? '收起详情' : '设备详情'}}
            </button>
          </view>
        </view>
      </block>
    </view>
  </block>

  <!-- ✅ 打开柜门弹窗 -->
  <view class="modal-mask" wx:if="{{showOpenLocker}}">
    <view class="modal">
      <view class="modal-title">请输入柜门编号</view>
      <input class="modal-input" type="number" placeholder="请输入柜号" bindinput="onLockerNoInput" />
      <view class="modal-buttons">
        <button class="cancel-btn" bindtap="closeModal">取消</button>
        <button class="confirm-btn" bindtap="confirmOpenLocker">确定</button>
      </view>
    </view>
  </view>
</view>
