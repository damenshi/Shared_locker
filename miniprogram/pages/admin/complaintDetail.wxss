.container {
  padding: 20rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  width: 180rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.status-badge {
  display: inline-block;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-pending { background: #fff3cd; color: #856404; }
.status-processing { background: #cce5ff; color: #004085; }
.status-resolved { background: #d4edda; color: #155724; }
.status-rejected { background: #f8d7da; color: #721c24; }

.content-box {
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.action-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.action-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.status-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.status-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  border: 2rpx solid #ddd;
  color: #666;
  background: #fff;
}

.status-btn.processing {
  border-color: #004085;
  color: #004085;
}

.status-btn.resolved {
  border-color: #155724;
  color: #155724;
}

.status-btn.rejected {
  border-color: #721c24;
  color: #721c24;
}

.reply-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.reply-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.reply-btn {
  background: #1e3a5f;
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 0;
  border-radius: 12rpx;
  text-align: center;
}

.existing-reply {
  background: #e8f4e8;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.existing-reply-label {
  font-size: 26rpx;
  color: #1e3a5f;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.existing-reply-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.existing-reply-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}
