.container {
  padding: 0;
  background: #f5f7fa;
  min-height: 100vh;
}

/* 头部信息卡片 */
.header-card {
  background: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 0;
  border-bottom: 1rpx solid #eee;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.complaint-type {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e3a5f;
}

.status-badge {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-pending { background: #fff3cd; color: #856404; }
.status-resolved { background: #d4edda; color: #155724; }

.header-info {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.info-label {
  color: #999;
  margin-right: 8rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.action-btn {
  flex: 1;
  background: #fff;
  border: 2rpx solid #1e3a5f;
  color: #1e3a5f;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-weight: 500;
}

.action-btn.resolve {
  background: #1e3a5f;
  color: #fff;
}

/* 对话区域 - 聊天背景 */
.chat-area {
  background: #ededed;
  padding: 30rpx 24rpx;
  min-height: 50vh;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ddd;
}

.message {
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.message:last-child {
  margin-bottom: 0;
}

.message-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  gap: 12rpx;
}

.message.user .message-header {
  justify-content: flex-end;
}

.message.admin .message-header {
  justify-content: flex-start;
}

.sender-name {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}

.message-time {
  font-size: 22rpx;
  color: #999;
}

/* 气泡样式 */
.bubble-wrapper {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.message.user .bubble-wrapper {
  flex-direction: row-reverse;
}

.message.admin .bubble-wrapper {
  flex-direction: row;
}

.bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  max-width: 75%;
  word-break: break-all;
  position: relative;
}

/* 用户消息 - 微信绿色 */
.message.user .bubble {
  background: #07C160;
  color: #fff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
}

/* 客服消息 - 白色带边框 */
.message.admin .bubble {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* 气泡小三角 */
.bubble::before {
  content: '';
  position: absolute;
  top: 20rpx;
  width: 0;
  height: 0;
  border: 12rpx solid transparent;
}

.message.user .bubble::before {
  right: -16rpx;
  border-left-color: #07C160;
  border-right: none;
}

.message.admin .bubble::before {
  left: -16rpx;
  border-right-color: #fff;
  border-left: none;
}

/* 回复输入区域 */
.reply-section {
  background: #fff;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #eee;
}

.reply-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  background: #f8f8f8;
}

.reply-input:focus {
  border-color: #1e3a5f;
  background: #fff;
}

.reply-btn {
  background: #1e3a5f;
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-weight: 500;
}
