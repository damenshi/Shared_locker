<view class="container">
  <!-- 顶部标题 -->
  <!-- <view class="header">
    <text class="title">储物柜系统管理</text>
  </view> -->

  <!-- 用户订单管理 -->
  <view class="card">
    <view class="card-title">📦 用户订单管理</view>
    <view class="input-item">
      <text>手机号：</text>
      <input 
        type="text" 
        value="{{userPhone}}" 
        data-field="userPhone"
        bindinput="onInputChange"
        placeholder="请输入用户手机号"
      />
    </view>
    <button 
      bindtap="goUserOrders" 
      class="primary-btn"
    >获取订单</button>
  </view>

   <!-- 设备订单管理 -->
   <view class="card">
    <view class="card-title">🗄️ 设备订单管理（显示最近20单）</view>
    <view class="input-item">
      <text>设备编号：</text>
      <input 
        type="text" 
        value="{{internalNo_ord}}" 
        data-field="internalNo_ord"
        bindinput="onInputChange"
        placeholder="如L0001"
      />
    </view>
    <view class="input-item">
      <text>柜门编号：</text>
      <input 
        type="number" 
        value="{{lockerNo_ord}}" 
        data-field="lockerNo_ord"
        bindinput="onInputChange"
        placeholder="如1"
      />
    </view>
    <button 
      bindtap="goDevOrders" 
      class="primary-btn"
    >获取订单</button>
  </view>

  <!-- 设备列表 -->
  <view class="card">
    <view class="card-title">🧭 设备列表</view>
    <button 
      bindtap="goMyDeviceList" 
      class="primary-btn"
    >获取设备列表</button>
  </view>

  <!-- 设备配置 -->
  <view class="card">
    <view class="card-title">⚙️ 设备配置</view>

    <view class="input-item">
      <text>设备编号：</text>
      <input 
        type="text" 
        value="{{internalNo}}" 
        data-field="internalNo"
        bindinput="onInputChange"
        placeholder="如 L0001"
      />
    </view>

    <view class="input-item">
      <text>安装地址：</text>
      <input 
        type="text" 
        value="{{deviceAddress}}" 
        data-field="deviceAddress"
        bindinput="onInputChange"
        placeholder="请输入设备地址"
      />
    </view>

    <view class="input-item">
      <text>收费标准：</text>
      <input 
        type="text" 
        value="{{deviceDeposit}}" 
        data-field="deviceDeposit"
        bindinput="onInputChange"
        placeholder="请输入押金金额"
      />
    </view>

    <view class="input-item">
      <text>屏幕编号：</text>
      <input 
        type="text" 
        value="{{screenNo}}" 
        data-field="screenNo"
        bindinput="onInputChange"
        placeholder="请输入屏幕编号"
      />
    </view>

    <view class="input-item">
      <text>锁板数量：</text>
      <input 
        type="number" 
        value="{{cabinetCount}}" 
        data-field="cabinetCount"
        bindinput="onInputChange"
        placeholder="请输入锁板数量"
      />
    </view>

    <view class="input-item">
      <text>每板锁数：</text>
      <input 
        type="number" 
        value="{{lockersPerCabinet}}" 
        data-field="lockersPerCabinet"
        bindinput="onInputChange"
        placeholder="请输入每块锁板的锁数量"
      />
    </view>

    <button 
      bindtap="batchCreateLockersByDevice" 
      class="primary-btn"
    >配置设备</button>
  </view>

  <!-- 柜门控制 -->
  <view class="card">
    <view class="card-title">🔓 柜门控制</view>
    <view class="input-item">
      <text>设备编号：</text>
      <input 
        type="text" 
        value="{{internalNo_ctl}}" 
        data-field="internalNo_ctl"
        bindinput="onInputChange"
        placeholder="如 L0001"
      />
    </view>
    <view class="input-item">
      <text>柜门编号：</text>
      <input 
        type="number" 
        value="{{lockerNo}}" 
        data-field="lockerNo"
        bindinput="onInputChange"
        placeholder="请输入柜门号"
      />
    </view>
    <button 
      bindtap="openAnyDoor" 
      class="primary-btn"
    >远程开门</button>
  </view>
</view>
