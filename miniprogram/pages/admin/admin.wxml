<view class="container">
  <!-- 顶部欢迎语 -->
  <view class="welcome-header">
    <text class="welcome-title">管理后台</text>
    <text class="welcome-subtitle">储物柜管理系统</text>
  </view>

  <!-- 免费设备列表 -->
  <view class="summary-section" wx:if="{{freeDevices.length > 0}}">
    <view class="summary-header">
      <text class="summary-title">当前免费设备</text>
      <text class="summary-count free">{{freeDevices.length}} 台</text>
    </view>
    <view class="summary-list">
      <view class="summary-item free" wx:for="{{freeDevices}}" wx:key="deviceId">
        <text class="summary-no">{{item.internalNo}}</text>
        <text class="summary-addr">{{item.deviceAddress || '无地址'}}</text>
        <text class="summary-status {{item.isOnline ? 'online' : 'offline'}}">{{item.isOnline ? '在线' : '离线'}}</text>
      </view>
    </view>
  </view>

  <!-- 离线设备列表 -->
  <view class="summary-section" wx:if="{{offlineDevices.length > 0}}">
    <view class="summary-header">
      <text class="summary-title">当前离线设备</text>
      <text class="summary-count offline">{{offlineDevices.length}} 台</text>
    </view>
    <view class="summary-list">
      <view class="summary-item offline" wx:for="{{offlineDevices}}" wx:key="deviceId">
        <text class="summary-no">{{item.internalNo}}</text>
        <text class="summary-addr">{{item.deviceAddress || '无地址'}}</text>
        <text class="summary-status offline-text">离线</text>
      </view>
    </view>
  </view>

  <!-- 分组标题：订单管理 -->
  <view class="section-header">
    <view class="section-line"></view>
    <text class="section-title">订单管理</text>
    <view class="section-line"></view>
  </view>

  <!-- 用户订单管理 -->
  <view class="card card-order">
    <view class="card-header-row">
      <view class="card-icon icon-order">
        <text class="icon-text">📦</text>
      </view>
      <view class="card-info">
        <view class="card-title">用户订单查询</view>
        <view class="card-desc">输入手机号查询用户的所有订单</view>
      </view>
    </view>
    <view class="input-row">
      <input
        type="text"
        value="{{userPhone}}"
        data-field="userPhone"
        bindinput="onInputChange"
        placeholder="请输入手机号"
        class="input-field"
      />
    </view>
    <view class="btn-row">
      <button bindtap="goUserOrders" class="action-btn">查询订单</button>
    </view>
  </view>

  <!-- 设备订单管理 -->
  <view class="card card-device">
    <view class="card-header-row">
      <view class="card-icon icon-device">
        <text class="icon-text">📋</text>
      </view>
      <view class="card-info">
        <view class="card-title">设备订单查询</view>
        <view class="card-desc">按设备编号和柜门号查询订单</view>
      </view>
    </view>
    <view class="input-row two-col">
      <input
        type="text"
        value="{{internalNo_ord}}"
        data-field="internalNo_ord"
        bindinput="onInputChange"
        placeholder="设备编号"
        class="input-field"
      />
      <input
        type="number"
        value="{{lockerNo_ord}}"
        data-field="lockerNo_ord"
        bindinput="onInputChange"
        placeholder="柜门号"
        class="input-field"
      />
    </view>
    <view class="btn-row">
      <button bindtap="goDevOrders" class="action-btn">查询订单</button>
    </view>
  </view>

  <!-- 分组标题：设备控制 -->
  <view class="section-header">
    <view class="section-line"></view>
    <text class="section-title">设备控制</text>
    <view class="section-line"></view>
  </view>

  <!-- 设备列表（更显眼） -->
  <view class="card card-device-list" bindtap="goMyDeviceList">
    <view class="card-header-row">
      <view class="card-icon icon-devices">
        <text class="icon-text">📋</text>
      </view>
      <view class="card-info">
        <view class="card-title">设备列表</view>
        <view class="card-desc">查看和管理所有储物柜设备</view>
      </view>
      <view class="card-arrow">›</view>
    </view>
  </view>

  <!-- 柜门控制 -->
  <view class="card card-door">
    <view class="card-header-row">
      <view class="card-icon icon-door">
        <text class="icon-text">🔓</text>
      </view>
      <view class="card-info">
        <view class="card-title">柜门控制</view>
        <view class="card-desc">远程控制柜门开关</view>
      </view>
    </view>
    <view class="input-row two-col">
      <input
        type="text"
        value="{{internalNo_ctl}}"
        data-field="internalNo_ctl"
        bindinput="onInputChange"
        placeholder="设备编号"
        class="input-field"
      />
      <input
        type="number"
        value="{{lockerNo}}"
        data-field="lockerNo"
        bindinput="onInputChange"
        placeholder="柜门号"
        class="input-field"
      />
    </view>
    <view class="btn-row">
      <button bindtap="openAnyDoor" class="action-btn btn-danger">远程开门</button>
    </view>
  </view>

  <!-- 一键清柜 -->
  <view class="card card-clear">
    <view class="card-header-row">
      <view class="card-icon icon-clear">
        <text class="icon-text">🧹</text>
      </view>
      <view class="card-info">
        <view class="card-title">一键清柜</view>
        <view class="card-desc">清空所有设备上的占用柜门</view>
      </view>
    </view>
    <view class="btn-row">
      <button bindtap="clearAllLockers" class="action-btn btn-danger">清空所有柜门</button>
    </view>
  </view>

  <!-- 分组标题：系统设置 -->
  <view class="section-header">
    <view class="section-line"></view>
    <text class="section-title">系统设置</text>
    <view class="section-line"></view>
  </view>

  <!-- 商户管理 -->
  <view class="card card-merchant">
    <view class="card-header-row">
      <view class="card-icon icon-merchant">
        <text class="icon-text">🏦</text>
      </view>
      <view class="card-info">
        <view class="card-title">商户管理</view>
        <view class="card-desc">切换支付商户号</view>
      </view>
    </view>

    <view class="merchant-list">
      <view
        wx:for="{{merchantList}}"
        wx:key="_id"
        class="merchant-item {{item.isActive ? 'active' : ''}}"
        bindtap="switchMerchant"
        data-id="{{item._id}}"
      >
        <view class="merchant-info">
          <view class="merchant-name">{{item.name}}</view>
          <view class="merchant-mchid">商户号: {{item.mchid}}</view>
        </view>
        <view class="merchant-status">
          <text wx:if="{{item.isActive}}" class="status-active">使用中</text>
          <text wx:else class="status-inactive">点击切换</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 全局免费设置 -->
  <view class="card card-free">
    <view class="card-header-row">
      <view class="card-icon icon-free">
        <text class="icon-text">🆓</text>
      </view>
      <view class="card-info">
        <view class="card-title">全局免费模式</view>
        <view class="card-desc">开启后所有储物柜将免费使用</view>
      </view>
    </view>
    <view class="toggle-row" bindtap="toggleFreeMode">
      <text class="toggle-label">{{isFreeMode ? '已开启免费模式' : '点击开启免费模式'}}</text>
      <view class="toggle {{isFreeMode ? 'on' : ''}}">
        <view class="toggle-thumb"></view>
      </view>
    </view>
  </view>

  <!-- 设备配置 -->
  <view class="card card-config">
    <view class="card-header-row">
      <view class="card-icon icon-config">
        <text class="icon-text">⚙️</text>
      </view>
      <view class="card-info">
        <view class="card-title">设备配置</view>
        <view class="card-desc">配置设备参数和储物柜信息</view>
      </view>
    </view>
    <view class="config-form">
      <view class="form-row">
        <view class="form-label">设备编号</view>
        <input
          type="text"
          value="{{internalNo}}"
          data-field="internalNo"
          bindinput="onInputChange"
          placeholder="如 L0001"
          class="form-input"
        />
      </view>
      <view class="form-row">
        <view class="form-label">安装地址</view>
        <input
          type="text"
          value="{{deviceAddress}}"
          data-field="deviceAddress"
          bindinput="onInputChange"
          placeholder="设备安装地址"
          class="form-input"
        />
      </view>
      <view class="form-row-group">
        <view class="form-col">
          <view class="form-label">押金(元)</view>
          <input
            type="number"
            value="{{deviceDeposit}}"
            data-field="deviceDeposit"
            bindinput="onInputChange"
            placeholder="0"
            class="form-input"
          />
        </view>
        <view class="form-col">
          <view class="form-label">时价(元/时)</view>
          <input
            type="number"
            value="{{unitPrice}}"
            data-field="unitPrice"
            bindinput="onInputChange"
            placeholder="0"
            class="form-input"
          />
        </view>
      </view>
      <view class="form-row-group">
        <view class="form-col">
          <view class="form-label">锁板数量</view>
          <input
            type="number"
            value="{{cabinetCount}}"
            data-field="cabinetCount"
            bindinput="onInputChange"
            placeholder="0"
            class="form-input"
          />
        </view>
        <view class="form-col">
          <view class="form-label">每板锁数</view>
          <input
            type="number"
            value="{{lockersPerCabinet}}"
            data-field="lockersPerCabinet"
            bindinput="onInputChange"
            placeholder="0"
            class="form-input"
          />
        </view>
      </view>
      <view class="form-row-group">
        <view class="form-col">
          <view class="form-label">屏幕编号</view>
          <input
            type="number"
            value="{{screenNo}}"
            data-field="screenNo"
            bindinput="onInputChange"
            placeholder="0"
            class="form-input"
          />
        </view>
        <view class="form-col">
          <view class="form-label">延迟退款</view>
          <picker bindchange="onDelayedRefundChange" value="{{delayedRefundIndex}}" range="{{delayedRefundOptions}}">
            <view class="form-input picker-value">{{delayedRefundOptions[delayedRefundIndex] || '请选择'}}</view>
          </picker>
        </view>
      </view>
    </view>
    <view class="btn-row">
      <button bindtap="batchCreateLockersByDevice" class="action-btn btn-primary">配置设备</button>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
