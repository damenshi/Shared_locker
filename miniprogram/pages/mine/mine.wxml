<view class="container">
  <!-- 顶部用户信息 -->
  <view class="user-info">
    <view class="avatar">
      <image 
        src="{{userInfo ? userInfo.avatarUrl : '/images/avatar-default.png'}}" 
        mode="widthFix"
      ></image>
    </view>
    <view class="user-detail">
      <view class="phone">
        {{userInfo ? userInfo.nickName : (phone || '未登录')}}
      </view>
      <view class="deposit">账户余额：¥{{deposit.toFixed(2)}}</view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list">
    <!-- 我的订单 -->
    <view class="menu-item" bindtap="goMyOrders">
      <view class="menu-text">我的订单</view>
    </view>

    <!-- 申请退款 -->
    <view class="menu-item" bindtap="handleRefund">
      <view class="menu-text">申请退款</view>
    </view>
  </view>
</view>