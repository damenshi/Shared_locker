.container {
  padding: 30rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.detail-type {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.detail-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-pending { background: #fff3cd; color: #856404; }
.status-processing { background: #cce5ff; color: #004085; }
.status-resolved { background: #d4edda; color: #155724; }
.status-rejected { background: #f8d7da; color: #721c24; }

.detail-row {
  display: flex;
  margin-bottom: 16rpx;
}

.detail-label {
  font-size: 28rpx;
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.detail-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.reply-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.reply-label {
  font-size: 28rpx;
  color: #1e3a5f;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.reply-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding: 20rpx;
  background: #e8f4e8;
  border-radius: 12rpx;
}

.reply-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: right;
}
