<view class="container">
  <block wx:if="{{!loading && orders.length === 0}}">
    <view class="empty">暂无订单</view>
  </block>

  <block wx:if="{{orders.length > 0}}">
    <view class="order-list">
      <block wx:for="{{orders}}" wx:key="_id">
        
        <view class="order-card" wx:if="{{index === 0 || isExpanded}}">
          
          <view class="order-header">
            <text class="order-id">订单号：{{item._id}}</text>
          </view>

          <view class="order-body">
            <view class="row">
              <text class="label">订单状态</text>
              <text class="status">{{item.displayStatus}}</text>
            </view>
            <view class="row">
              <text class="label">手机号</text>
              <text class="value">{{item.phone}}</text>
            </view>
            <view class="row">
              <text class="label">取件码</text>
              <text class="value">{{item.password}}</text>
            </view>
            <view class="row">
              <text class="label">设备编号</text>
              <text class="value">{{item.internalNo}}</text>
            </view>
            <view class="row">
              <text class="label">柜号</text>
              <text class="value">{{item.lockerNo}}</text>
            </view>
            <view class="row">
              <text class="label">设备地址</text>
              <text class="value">{{item.deviceAddress}}</text>
            </view>
            <view class="row">
              <text class="label">创建时间</text>
              <text class="value">{{item.createdAtFormatted}}</text>
            </view>
            <view class="row">
              <text class="label">付款金额</text>
              <text class="value-highlight">{{item.deposit}} 元</text>
            </view>
            <block wx:if="{{item.endAtFormatted}}">
              <view class="row">
                <text class="label">结束时间</text>
                <text class="value">{{item.endAtFormatted}}</text>
              </view>
              <view class="row">
                <text class="label">使用时长</text>
                <text class="value">{{item.usageDurationFormatted}}</text>
              </view>
              <view class="row">
                <text class="label">使用费用</text>
                <text class="value">{{item.fee}}</text>
              </view>
              <view class="row">
                <text class="label">可退金额</text>
                <text class="value">{{item.refundAmount}}</text>
              </view>
            </block>
          </view>
          <view class="action-btns">
            <button class="btn complaint"
                    bindtap="goComplaint"
                    data-id="{{item._id}}">
              投诉
            </button>
            <button class="btn refund"
                    wx:if="{{(item.status === '已完成' || item.status === '已关闭' || item.status === '进行中' || item.status === '已强制结束') && item.deposit > 0}}"
                    bindtap="refund"
                    data-openid="{{item.openid}}"
                    data-id="{{item._id}}">
              退款
            </button>
            <button class="btn" wx:elif="{{(item.status === '已完成' || item.status === '已关闭' || item.status === '进行中' || item.status === '已强制结束') && item.deposit <= 0}}" disabled>无需退款</button>
            <button class="btn" wx:elif="{{item.status === '待提现'}}" disabled>退款中</button>
          </view>
        </view>
      </block>

      <view class="footer-tips">
        点击退款后会在0～3天内完成结算，并转入余额。
        可前往【我的余额】提现。
      </view>

      <view wx:if="{{orders.length > 1}}" class="expand-control" bindtap="toggleHistory">
        <text>{{isExpanded ? '收起历史订单' : '历史订单'}}</text>
        <text class="arrow">{{isExpanded ? '▲' : '▼'}}</text>
      </view>

    </view>
  </block>
</view>