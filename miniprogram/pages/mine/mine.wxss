/* 明亮极简风格 */

page {
  height: 100%;
  background: #f8fafc;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
}

/* 顶部区域 */
.top-section {
  padding: 48rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e2e8f0;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

/* 头像 - 圆形深蓝 */
.avatar {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.15);
}

.avatar-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-label {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 3rpx;
}

.user-value {
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 600;
}

/* 菜单区域 */
.menu-section {
  flex: 1;
  padding: 32rpx 48rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  transition: all 0.2s ease;
}

.menu-item:active {
  opacity: 0.6;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 圆点标记 */
.item-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #cbd5e1;
}

.item-dot.gold {
  background: linear-gradient(135deg, #c9a961 0%, #b8944f 100%);
}

.item-dot.blue {
  background: #1e3a5f;
}

.item-text {
  font-size: 32rpx;
  color: #334155;
  font-weight: 500;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-extra {
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 400;
}

/* 箭头 */
.item-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid #cbd5e1;
  border-right: 2rpx solid #cbd5e1;
  transform: rotate(45deg);
}

/* 管理员入口 */
.admin-entry {
  margin-top: 48rpx;
  padding: 28rpx 0;
  text-align: center;
  background: #f8fafc;
  border: 2rpx solid #1e3a5f;
  border-radius: 8rpx;
  transition: all 0.2s ease;
}

.admin-entry:active {
  background: #1e3a5f;
}

.admin-entry:active .admin-text {
  color: #ffffff;
}

.admin-text {
  font-size: 28rpx;
  color: #1e3a5f;
  letter-spacing: 4rpx;
  font-weight: 500;
}

/* 底部导航 */
.bottom-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 32rpx 80rpx 48rpx;
  gap: 48rpx;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  transition: all 0.3s ease;
}

.nav-item:active {
  opacity: 0.7;
}

.nav-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #cbd5e1;
  transition: all 0.3s ease;
}

.nav-item.active .nav-dot {
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #1e3a5f;
}

.nav-text {
  font-size: 26rpx;
  color: #94a3b8;
  letter-spacing: 4rpx;
  font-weight: 400;
}

.nav-item.active .nav-text {
  color: #1e3a5f;
  font-weight: 600;
}

.nav-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e2e8f0;
}
