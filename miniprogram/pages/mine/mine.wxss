/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  padding-bottom: 20rpx;
}

/* 用户信息区域 */
.user-info {
  background: linear-gradient(135deg, #5ac8fa, #4da6f7); /* 柔和蓝色渐变 */
  padding: 48rpx 32rpx 40rpx 32rpx;
  color: white;
  display: flex;
  align-items: center;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  overflow: hidden;
  cursor: pointer;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.phone {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.deposit {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 功能菜单 */
.menu-list {
  background-color: #fff;
  margin: 20rpx 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f1f1;
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f2f5f8;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

/* 箭头提示 */
.menu-arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 订单列表 */
.order-list {
  margin: 20rpx 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.order-item {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s;
}

.order-item:last-child {
  border-bottom: none;
}

.order-item:active {
  background-color: #f2f5f8;
}

.order-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-no {
  font-size: 28rpx;
  color: #666;
}

.order-status {
  font-size: 28rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.status-success {
  color: #52c41a;
  background-color: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.status-refund {
  color: #faad14;
  background-color: #fffbe6;
  border: 1rpx solid #ffe58f;
}

.status-processing {
  color: #1890ff;
  background-color: #e6f7ff;
  border: 1rpx solid #91d5ff;
}

.order-detail {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

/* 按钮 */
.refund-btn {
  background-color: #1890ff;
  color: white;
  font-size: 28rpx;
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
  line-height: normal;
  text-align: center;
  display: inline-block;
  transition: background 0.2s, transform 0.15s;
}

.refund-btn:active {
  background-color: #096dd9;
  transform: scale(0.97);
}

.refund-all-btn {
  background-color: #ff4d4f;
}

.refund-all-btn:active {
  background-color: #d93025;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
