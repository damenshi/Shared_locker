<view class="container">
  <view class="create-btn" bindtap="goComplaintForm">
    + 发起新投诉
  </view>

  <block wx:if="{{!loading && complaints.length === 0}}">
    <view class="empty">暂无投诉记录</view>
  </block>

  <block wx:if="{{complaints.length > 0}}">
    <view class="complaint-list">
      <view
        class="complaint-card"
        wx:for="{{complaints}}"
        wx:key="_id"
        bindtap="goComplaintDetail"
        data-id="{{item._id}}"
      >
        <view class="card-header">
          <text class="type-tag">{{item.typeText}}</text>
          <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="card-phone">{{item.phone || '未填写手机号'}}</view>
        <view class="card-content">{{item.content}}</view>
        <view class="card-footer">{{item.createdAtFormatted}}</view>
        <view class="order-link" wx:if="{{item.orderId}}">
          关联订单：{{item.orderId}}
        </view>
      </view>
    </view>
  </block>

  <view class="wait-tip">
    <text>客服会在24小时内进行处理，请耐心等待，如有疑问请拨打</text>
    <text class="tip-link" bindtap="callService">客服电话</text>
  </view>
</view>
