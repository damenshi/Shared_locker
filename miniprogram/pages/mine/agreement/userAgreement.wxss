/* miniprogram/pages/agreement/userAgreement.wxss */

/* 页面整体容器 */
.agreement-container {
  padding: 30rpx 40rpx; /* 左右留出足够的阅读边距 */
  background-color: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 协议标题 */
.title {
  font-size: 38rpx;
  font-weight: bold;
  text-align: center;
  color: #333333;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

/* 生效日期 */
.date {
  font-size: 26rpx;
  color: #999999;
  text-align: right; /* 日期靠右显示 */
  margin-bottom: 50rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eeeeee; /* 加一条分割线 */
}

/* 正文区域 */
.content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8; /* 增加行高，避免文字太密 */
}

/* 每一个大的章节条款 */
.section {
  margin-bottom: 50rpx; /* 条款之间拉开距离 */
}

/* 条款标题（如：一、禁止寄存物品） */
.h3 {
  font-size: 32rpx;
  font-weight: bold;
  color: #000000;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 0;
}

/* 段落文本 */
.p {
  display: block; /* 让 text 标签表现为块级元素，独占一行 */
  margin-bottom: 15rpx;
  text-align: justify; /* 两端对齐，让大段文字边缘整齐 */
}

/* 重点加粗样式 */
.bold {
  font-weight: bold;
  color: #333333; /* 加粗文字颜色加深，突出显示 */
}