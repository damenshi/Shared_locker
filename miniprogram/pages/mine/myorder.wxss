.container {
  padding: 20rpx;
  background: #f5f5f7;
  min-height: 100vh;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 30rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  padding: 30rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.order-id {
  color: #333;
  font-size: 28rpx;
}

.status {
  color: #007aff; /* iOS 蓝色 */
  font-size: 26rpx;
}

.order-body .row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.order-body .row:last-child {
  border-bottom: none;
}

.label {
  color: #666;
  font-size: 26rpx;
}

.value {
  color: #333;
  font-size: 26rpx;
}

.value-highlight {
  color: #007aff;
  font-size: 28rpx;
  font-weight: 600;
}

/* === 新增样式：展开控制条 === */
.expand-control {
  padding: 20rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  display: flex;     
  align-items: center; 
  justify-content: flex-end;
}

.arrow {
  margin-left: 10rpx;
  font-size: 20rpx;
}

.action-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.complaint-link {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
  padding: 8rpx 0;
}

.footer-tips {
  text-align: center;
  font-size: 28rpx; /* 字号较小 */
  color: #999;      /* 浅灰色 */
  padding: 30rpx 0; /* 上下留出间距 */
  margin-top: 10rpx;
}