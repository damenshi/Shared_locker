<view class="container">
  <view class="page-header">
    <view class="header-title">我的余额</view>
    <view class="header-desc">系统结算完成后可提现</view>
  </view>
  
  <block wx:if="{{latestItem}}">
    <view class="section-title">最近提交</view>
    <view class="card">
      <view class="card-header">
        <text class="label">订单号</text>
        <text class="value">{{latestItem.outTradeNo || latestItem._id}}</text>
      </view>

      <view class="card-body">
        <view class="amount-box">
          <text class="symbol">￥</text>
          <text class="num">{{latestItem.refundAmount}}</text>
        </view>

        <view class="action-box">
          <view wx:if="{{latestItem.status === '已退款'}}" class="status-tag" style="color: #52c41a; background: #f6ffed; border: 1px solid #b7eb8f;">
            <text class="icon">✅</text>
            <text>已退款</text>
          </view>
          
          <view 
              wx:elif="{{latestItem.canWithdraw}}" 
              class="text-withdraw" 
              bindtap="doWithdraw" 
              data-id="{{latestItem._id}}">
              提现 >
            </view>
          
          <view wx:else class="status-tag">
            <text class="icon">⏳</text>
            <text>结算中</text>
          </view>
        </view>
      </view>

      <view class="card-footer">
        <view class="time-row">
          <text class="label">申请时间：</text>
          <text class="val">{{latestItem.displayTime}}</text>
        </view>
        <view class="time-row highlight" wx:if="{{!latestItem.canWithdraw}}">
          <text class="label">预计可提：</text>
          <text class="val">{{latestItem.availableTime}}</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{historyList.length > 0}}">
    <view class="history-toggle" bindtap="toggleHistory">
      <text>显示全部</text>
      <text class="arrow {{showHistory ? 'up' : ''}}">▼</text>
    </view>

    <view class="history-content" wx:if="{{showHistory}}">
      <view class="card" wx:for="{{historyList}}" wx:key="_id">
        <view class="card-header">
          <text class="label">订单号</text>
          <text class="value">{{item.outTradeNo || item._id}}</text>
        </view>

        <view class="card-body">
          <view class="amount-box">
            <text class="symbol">￥</text>
            <text class="num">{{item.refundAmount}}</text>
          </view>

          <view class="action-box">
            <view wx:if="{{item.status === '已退款'}}" class="status-tag" style="color: #52c41a; background: #f6ffed; border: 1px solid #b7eb8f;">
              <text class="icon">✅</text>
              <text>已退款</text>
            </view>

            <view 
              wx:elif="{{latestItem.canWithdraw}}" 
              class="text-withdraw" 
              bindtap="doWithdraw" 
              data-id="{{latestItem._id}}">
              提现 >
            </view>
            
            <view wx:else class="status-tag">
              <text class="icon">⏳</text>
              <text>结算中</text>
            </view>
          </view>
        </view>

        <view class="card-footer">
          <view class="time-row">
            <text class="label">申请时间：</text>
            <text class="val">{{item.displayTime}}</text>
          </view>
          <view class="time-row highlight" wx:if="{{!item.canWithdraw}}">
            <text class="label">预计可提：</text>
            <text class="val">{{item.availableTime}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
  
  <view wx:if="{{!latestItem}}" class="empty-state">
    <image class="empty-icon" src="" /> <text>暂无退款记录</text>
  </view>
</view>