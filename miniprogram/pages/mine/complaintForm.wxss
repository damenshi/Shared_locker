.container {
  padding: 30rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.type-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-option {
  padding: 16rpx 32rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  background: #fff;
}

.type-option.selected {
  border-color: #1e3a5f;
  color: #1e3a5f;
  background: #f0f4f8;
}

.order-info {
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.required {
  color: #e74c3c;
  margin-left: 4rpx;
}

.phone-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  background: #fff;
}

.phone-input:disabled {
  background: #f5f5f5;
  color: #999;
}

.input-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.submit-btn {
  background: #1e3a5f;
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 0;
  border-radius: 12rpx;
  text-align: center;
  margin-top: 40rpx;
}

.submit-btn.disabled {
  background: #ccc;
}
