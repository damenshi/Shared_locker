<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">投诉类型</text>
      <view class="type-options">
        <view
          class="type-option {{type === 'refund' ? 'selected' : ''}}"
          bindtap="selectType"
          data-type="refund"
        >退款问题</view>
        <view
          class="type-option {{type === 'door' ? 'selected' : ''}}"
          bindtap="selectType"
          data-type="door"
        >柜门打不开</view>
        <view
          class="type-option {{type === 'other' ? 'selected' : ''}}"
          bindtap="selectType"
          data-type="other"
        >其他</view>
      </view>
    </view>

    <view class="form-item" wx:if="{{orderId}}">
      <text class="form-label">关联订单</text>
      <view class="order-info">
        订单号：{{orderId}}
        <view wx:if="{{orderInfo}}">
          设备：{{orderInfo.internalNo}} | 柜号：{{orderInfo.lockerNo}}
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">投诉描述</text>
      <textarea
        class="content-input"
        placeholder="请详细描述您遇到的问题，最多500字"
        maxlength="500"
        bindinput="onContentInput"
        value="{{content}}"
      />
      <view class="char-count">{{content.length}}/500</view>
    </view>

    <view
      class="submit-btn {{!canSubmit ? 'disabled' : ''}}"
      bindtap="submitComplaint"
    >提交投诉</view>
  </view>
</view>
