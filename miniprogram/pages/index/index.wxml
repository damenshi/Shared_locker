<view class="page">
  <!-- 头部信息 -->
  <view class="header">
    <view class="school-name">{{deviceAddress}}</view>
    <view class="business-hours">营业时间：00:00~24:00</view>

    <!-- ✅ 新增：右上角显示空闲柜 -->
    <view class="free-lockers">
      <text>空闲柜门：</text>
      <text class="free-count">{{freeDoorCnt}}</text>
    </view>
  </view>
  
  <!-- 帮助提示 -->
  <view class="help-box">
    <view class="help-question">
      <icon type="info_circle" color="#ff6b3b" size="16"></icon>
      <text class="question-text">手机存进去怎么取?</text>
    </view>
    <view class="help-answer">
      <icon type="success_circle" color="#666" size="16"></icon>
      <text class="answer-text">在显示屏上用【手机号+4位密码】取包</text>
    </view>
  </view>
  
  <!-- 输入区域 -->
  <view class="input-container">
    <view class="input-title">设置取包 手机号及密码</view>

    <!-- 手机号输入框 + 自动获取按钮 -->
    <view class="input-item phone-input-item">
      <text class="input-label">手机号</text>
      <view class="phone-input-box">
        <input
          class="input-field"
          type="number"
          placeholder="请输入手机号"
          maxlength="11"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
        <button
          class="auto-btn"
          open-type="getPhoneNumber"
          bindgetphonenumber="getPhoneNumber"
        >
          自动获取
        </button>
      </view>
    </view>

    <!-- 密码输入框 -->
    <view class="input-item phone-input-item">
      <text class="input-label">取包密码</text>
      <view class="phone-input-box">
        <input
          class="input-field"
          type="number"
          placeholder="4位数字，建议使用出生日期"
          maxlength="4"
          bindinput="onPasswordInput"
        />
      </view>
    </view>

    <view class="password-hint">
      建议生日日期，例：0109（01月09日）
    </view>
  </view>

  <!-- 下一步按钮 -->
  <!-- <view
    class="next-btn {{!canProceed ? 'disabled' : ''}}"
    bindtap="{{canProceed ? 'goToNextPage' : ''}}">
    下一步
  </view> -->
  <view class="next-btn {{!canProceed ? 'disabled' : ''}}" bindtap="{{canProceed ? 'goToNextPage' : ''}}">
    下一步
  </view>

  <!-- 投诉/客服提示 -->
  <view class="service-tip">
    <view class="service-tip-content">
      <icon type="info_circle" color="#1e3a5f" size="14"></icon>
      <text class="tip-text">任何使用问题欢迎</text>
      <text class="tip-link" bindtap="goComplaint">投诉建议</text>
      <text class="tip-text">或拨打</text>
      <text class="tip-link" bindtap="callService">客服电话</text>
    </view>
  </view>

<view wx:if="{{showLockerBox}}" class="locker-box-large">
  <text class="locker-box-text">柜门 {{openedLockerNo}} 使用中</text>

  <view class="locker-btn-row">
    <button class="reopen-btn" bindtap="midopenLocker">中途开柜</button>
    <button class="reopen-btn finish-btn" bindtap="finishUse">结束使用</button>
  </view>
</view>


<!-- 自定义确认弹窗 -->
<view wx:if="{{showConfirmModal}}" class="custom-modal-mask">
  <view class="custom-modal-box">
    <view class="custom-modal-title">请确认信息</view>
    <view class="custom-modal-content">
      <text class="highlight-text">手机号：{{phone}}</text>
      <text class="highlight-text">取件码：{{password}}</text>
      <text style="font-size:28rpx; color:#555; display:block; margin-top:12rpx; text-align:center;">
        请确认信息，否则可能无法取件!!!
      </text>
    </view>
    <view class="custom-modal-buttons">
      <button class="cancel-btn" bindtap="handleCancelConfirm">返回修改</button>
      <button class="confirm-btn" bindtap="handleConfirmNext">确认无误</button>
    </view>
  </view>
</view>


</view>
