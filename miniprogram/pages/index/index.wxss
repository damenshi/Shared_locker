/* 页面容器 - 商务风格 */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f8fafc;
  padding: 0;
  position: relative;
  font-family: "SF Pro Display", "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", sans-serif;
}

/* 顶部装饰条 */
.page::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #1e3a5f 0%, #2d4a6f 50%, #c9a961 100%);
  z-index: 1;
}

/* 返回首页按钮 */
.home-btn {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  z-index: 10;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}
.home-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 7rpx rgba(0, 0, 0, 0.12);
}

/* 顶部信息 - 商务卡片风格 */
.header {
  position: relative;
  margin: 24rpx 24rpx 32rpx;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(30, 58, 95, 0.06);
  border-left: 6rpx solid #1e3a5f;
}

.school-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1e3a5f;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.business-hours {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 400;
}

/* ====== 空闲柜显示 - 商务风格 ====== */
.free-lockers {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
  border-radius: 4rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.15);
}

.free-lockers::before {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #c9a961;
  margin-right: 12rpx;
  animation: breathe 2.5s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.1); }
}

.free-count {
  font-weight: 600;
  color: #c9a961;
  margin-left: 8rpx;
  font-size: 32rpx;
}

/* 帮助提示框 - 商务风格 */
.help-box {
  background-color: #fff;
  border-radius: 4rpx;
  padding: 28rpx;
  margin: 0 24rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.04);
  border: 1rpx solid #e5e7eb;
}

.help-question, .help-answer {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.help-question:last-child, .help-answer:last-child {
  margin-bottom: 0;
}

.question-text {
  color: #1e3a5f;
  font-size: 30rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.answer-text {
  color: #444;
  font-size: 30rpx;
  margin-left: 10rpx;
  line-height: 42rpx;
}

/* 输入表单区域 - 商务风格 */
.input-container {
  background-color: #fff;
  border-radius: 4rpx;
  padding: 32rpx;
  margin: 0 24rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.04);
  border: 1rpx solid #e5e7eb;
}

.input-title {
  font-size: 34rpx;
  color: #1c1c1e;
  margin-bottom: 32rpx;
  font-weight: 600;
}

/* 输入框通用样式 - 商务底线风格 */
.input-item {
  display: flex;
  align-items: center;
  border: none;
  border-bottom: 2rpx solid #e5e7eb;
  border-radius: 0;
  padding: 0 0 16rpx 0;
  height: auto;
  margin-bottom: 32rpx;
  background-color: transparent;
  transition: all 0.2s ease;
}
.input-item:focus-within {
  border-bottom-color: #1e3a5f;
}

.input-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #4b5563;
  font-weight: 500;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  height: 100%;
  background-color: transparent;
  outline: none;
  color: #333;
}

.input-field::placeholder {
  color: #bbb;
}

/* 手机号输入框（内嵌按钮） */
.phone-input-box {
  display: flex;
  align-items: center;
  flex: 1;
  background-color: transparent;
  border-radius: 0;
  overflow: hidden;
  border: none;
  height: 64rpx;
  border-bottom: 2rpx solid transparent;
}

.phone-input-box .input-field {
  flex: 1;
  padding-left: 20rpx;
  font-size: 28rpx;
  height: 100%;
  border: none;
  outline: none;
  background-color: transparent;
}

.phone-input-box .auto-btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  width: auto;
  min-width: 100rpx;
  height: 52rpx;
  margin: 0;
  border: none;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
  color: #fff;
  line-height: 52rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.2);
  transition: all 0.2s ease;
}

.phone-input-box .auto-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(30, 58, 95, 0.25);
}

/* 密码提示文字 */
.password-hint {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 12rpx;
  text-align: right;
}

/* 投诉/客服提示 */
.service-tip {
  margin: 0 24rpx;
  padding: 0;
}

.service-tip-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #eef2f7;
  border: 1rpx solid #d5dde6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
}

.tip-text {
  color: #666;
}

.tip-link {
  color: #1e3a5f;
  font-weight: 600;
  border-bottom: 2rpx solid #1e3a5f;
  padding-bottom: 2rpx;
}

/* 按钮 - 商务风格 */
.next-btn {
  background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
  color: #fff;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 4rpx;
  margin: 24rpx;
  text-align: center;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(30, 58, 95, 0.2);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.next-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #c9a961, transparent);
}

.next-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 3rpx 12rpx rgba(30, 58, 95, 0.3);
}

.next-btn[disabled] {
  background: #d1d5db;
  color: #9ca3af;
  box-shadow: none;
  cursor: not-allowed;
}

.next-btn[disabled]::after {
  display: none;
}

/* 固定开柜框 - 商务风格 */
.locker-box-large {
  margin: 24rpx;
  padding: 40rpx;
  border-radius: 4rpx;
  background-color: #ffffff;
  border: 2rpx solid #1e3a5f;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.08);
}

.locker-box-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #1e3a5f;
  margin-bottom: 32rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.reopen-btn {
  background-color: #ffffff;
  color: #1e3a5f;
  border: 2rpx solid #1e3a5f;
  border-radius: 4rpx;
  font-size: 28rpx;
  height: 76rpx;
  width: 220rpx;
  line-height: 76rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.2s ease;
}

.reopen-btn:active {
  background-color: #1e3a5f;
  color: #ffffff;
}

.locker-btn-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 32rpx;
}

.finish-btn {
  background: linear-gradient(135deg, #c9a961 0%, #b8944f 100%);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(201, 169, 97, 0.25);
}

.finish-btn:active {
  box-shadow: 0 2rpx 8rpx rgba(201, 169, 97, 0.35);
  opacity: 0.9;
}


/* 遮罩层 */
.custom-modal-mask {
  position: fixed;
  top:0; left:0; right:0; bottom:0;
  background-color: rgba(0,0,0,0.35);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 弹窗盒子 - 商务风格 */
.custom-modal-box {
  width: 75%;
  background-color: #fff;
  border-radius: 4rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(30, 58, 95, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: scaleIn 0.25s ease;
  border-top: 6rpx solid #1e3a5f;
}

@keyframes scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 标题 */
.custom-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: #1e3a5f;
  letter-spacing: 2rpx;
}

/* 内容 */
.custom-modal-content {
  font-size: 30rpx;
  line-height: 46rpx;
  text-align: center;
  margin-bottom: 36rpx;
}

/* 高亮手机号和密码 */
.highlight-text {
  color: #1e3a5f;
  font-weight: 600;
  font-size: 36rpx;
  text-align: center;
  display: block;
  margin: 12rpx 0;
  letter-spacing: 2rpx;
}

/* 按钮容器 */
.custom-modal-buttons {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 弹窗按钮 */
.confirm-btn, .cancel-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 4rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 84rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.2s ease;
}

.confirm-btn {
  background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.2);
  position: relative;
  overflow: hidden;
}

.confirm-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c9a961, transparent);
}

.confirm-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.3);
}

.cancel-btn {
  background-color: #f3f4f6;
  color: #4b5563;
  border: 1rpx solid #e5e7eb;
}

.cancel-btn:active {
  background-color: #e5e7eb;
}
