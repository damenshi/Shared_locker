/* 页面容器 */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f8f9fb;
  padding: 24rpx;
  position: relative;
  font-family: "SF Pro Display", "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", sans-serif;
}

/* 返回首页按钮 */
.home-btn {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  z-index: 10;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}
.home-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 7rpx rgba(0, 0, 0, 0.12);
}

/* 顶部信息 */
.header {
  position: relative;
  margin-bottom: 36rpx;
}

.school-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1c1c1e;
  margin-bottom: 8rpx;
}

.business-hours {
  font-size: 28rpx;
  color: #9a9a9a;
}

/* ====== 空闲柜显示 ====== */
.free-lockers {
  position: absolute;
  right: 0;
  top: 0;
  background-color: #ffffff;
  border-radius: 30rpx;
  padding: 14rpx 36rpx;
  font-size: 42rpx;
  color: #111;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #eaeaea;
}

.free-lockers::before {
  content: '';
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #10b981;
  margin-right: 12rpx;
  animation: breathe 2.5s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(1.15); }
}

.free-count {
  font-weight: 700;
  color: #10b981;
  margin-left: 6rpx;
}

/* 帮助提示框 */
.help-box {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #f2f2f2;
}

.help-question, .help-answer {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.help-question:last-child, .help-answer:last-child {
  margin-bottom: 0;
}

.question-text {
  color: #ff5a3c;
  font-size: 30rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.answer-text {
  color: #444;
  font-size: 30rpx;
  margin-left: 10rpx;
  line-height: 42rpx;
}

/* 输入表单区域 */
.input-container {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #f2f2f2;
}

.input-title {
  font-size: 34rpx;
  color: #1c1c1e;
  margin-bottom: 32rpx;
  font-weight: 600;
}

/* 输入框通用样式 */
.input-item {
  display: flex;
  align-items: center;
  border: 1rpx solid #e6e6e6;
  border-radius: 14rpx;
  padding: 0 20rpx;
  height: 82rpx;
  margin-bottom: 20rpx;
  background-color: #fafafa;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
  transition: all 0.2s ease;
}
.input-item:focus-within {
  border-color: #1677ff;
  box-shadow: 0 4rpx 10rpx rgba(22, 119, 255, 0.12);
}

.input-label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  height: 100%;
  background-color: transparent;
  outline: none;
  color: #333;
}

.input-field::placeholder {
  color: #bbb;
}

/* 手机号输入框（内嵌按钮） */
.phone-input-box {
  display: flex;
  align-items: center;
  flex: 1;
  background-color: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #e6e6e6;
  height: 64rpx;       /* 调小输入框高度 */
}

.phone-input-box .input-field {
  flex: 1;
  padding-left: 20rpx;
  font-size: 28rpx;
  height: 100%;
  border: none;
  outline: none;
  background-color: transparent;
}

.phone-input-box .auto-btn {
  font-size: 24rpx;         /* 字体稍小 */
  padding: 0 12rpx;         /* 左右内边距小一点 */
  width: auto;               /* 宽度根据内容自适应 */
  min-width: 80rpx;          /* 设置最小宽度，保证点击区域够用 */
  height: 48rpx;             /* 调整高度，让按钮更小巧 */
  margin: 0;
  border: none;
  border-left: 1rpx solid #e6e6e6;
  border-radius: 8rpx;       /* 小圆角 */
  background-color: #1677ff;
  color: #fff;
  line-height: 48rpx;
  font-weight: 500;
  box-shadow: none;          /* 内嵌按钮不要阴影 */
  transition: all 0.2s ease;
}

.phone-input-box .auto-btn:active {
  transform: scale(0.97);
  background-color: #105ecf;
}

/* 密码提示文字 */
.password-hint {
  font-size: 26rpx;
  color: #007aff;
  margin-top: 12rpx;
  text-align: right;
}

/* 按钮（iOS 风格） */
.next-btn {
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  margin-top: 24rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.25);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.next-btn:active {
  transform: scale(0.97);
  box-shadow: 0 3rpx 10rpx rgba(22, 119, 255, 0.35);
}

.next-btn[disabled] {
  background-color: #d7d7d7;
  color: #fff;
  box-shadow: none;
  cursor: not-allowed;
}

/* 固定开柜框 */
.locker-box-large {
  margin-top: 48rpx;
  padding: 40rpx 24rpx;
  border-radius: 28rpx;
  background-color: #f0f7ff;
  border: 1rpx solid #1677ff;
  display: flex;
  flex-direction: column;  
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(22,119,255,0.15);
}

.locker-box-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #1677ff;
  margin-bottom: 24rpx;
  text-align: center;
}

.reopen-btn {
  background-color: #ffffff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
  border-radius: 36rpx;
  font-size: 28rpx;
  height: 70rpx;
  width: 200rpx;
  line-height: 70rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(22,119,255,0.15);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.reopen-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(22,119,255,0.2);
}

.locker-btn-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
}

.finish-btn {
  background-color: #ff4d4f;
  color: #ffffff;
  border-color: #ff4d4f;
  box-shadow: 0 4rpx 10rpx rgba(255, 77, 79, 0.15);
}

.finish-btn:active {
  box-shadow: 0 2rpx 6rpx rgba(255, 77, 79, 0.2);
}


/* 遮罩层 */
.custom-modal-mask {
  position: fixed;
  top:0; left:0; right:0; bottom:0;
  background-color: rgba(0,0,0,0.35);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 弹窗盒子 */
.custom-modal-box {
  width: 75%;
  background-color: #fff;
  border-radius: 28rpx;
  padding: 40rpx 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(0,0,0,0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: scaleIn 0.25s ease;
}

@keyframes scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 标题 */
.custom-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: #111;
}

/* 内容 */
.custom-modal-content {
  font-size: 30rpx;
  line-height: 46rpx;
  text-align: center;
  margin-bottom: 36rpx;
}

/* 高亮手机号和密码 */
.highlight-text {
  color: #ff3b30;
  font-weight: 700;
  font-size: 36rpx;
  text-align: center;
  display: block;
  margin: 12rpx 0;
}

/* 按钮容器 */
.custom-modal-buttons {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 弹窗按钮 */
.confirm-btn, .cancel-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.2s ease;
}

.confirm-btn {
  background-color: #007aff;
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(0,122,255,0.25);
}

.confirm-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(0,122,255,0.25);
}

.cancel-btn {
  background-color: #f2f2f7;
  color: #333;
}

.cancel-btn:active {
  transform: scale(0.97);
}
