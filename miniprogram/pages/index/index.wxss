/* 页面容器 */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f8f9fb;
  padding: 24rpx;
  position: relative;
  font-family: "SF Pro Display", "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", sans-serif;
}

/* 返回首页按钮 */
.home-btn {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  z-index: 10;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}
.home-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 7rpx rgba(0, 0, 0, 0.12);
}

/* 顶部信息 */
.header {
  position: relative;
  margin-bottom: 36rpx;
}

.school-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1c1c1e;
  margin-bottom: 8rpx;
}

.business-hours {
  font-size: 28rpx;
  color: #9a9a9a;
}

/* ====== 空闲柜显示 ====== */
.free-lockers {
  position: absolute;
  right: 0;
  top: 0;
  background-color: #ffffff;
  border-radius: 30rpx;
  padding: 14rpx 36rpx;
  font-size: 42rpx;
  color: #111;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #eaeaea;
}

.free-lockers::before {
  content: '';
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #10b981;
  margin-right: 12rpx;
  animation: breathe 2.5s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(1.15); }
}

.free-count {
  font-weight: 700;
  color: #10b981;
  margin-left: 6rpx;
}

/* 帮助提示框 */
.help-box {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #f2f2f2;
}

.help-question, .help-answer {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.help-question:last-child, .help-answer:last-child {
  margin-bottom: 0;
}

.question-text {
  color: #ff5a3c;
  font-size: 30rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.answer-text {
  color: #444;
  font-size: 30rpx;
  margin-left: 10rpx;
  line-height: 42rpx;
}

/* 输入表单区域 */
.input-container {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #f2f2f2;
}

.input-title {
  font-size: 34rpx;
  color: #1c1c1e;
  margin-bottom: 32rpx;
  font-weight: 600;
}

.input-item {
  display: flex;
  align-items: center;
  border: 1rpx solid #e6e6e6;
  border-radius: 14rpx;
  padding: 0 20rpx;
  height: 82rpx;
  margin-bottom: 20rpx;
  background-color: #fafafa;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
  transition: all 0.2s ease;
}
.input-item:focus-within {
  border-color: #1677ff;
  box-shadow: 0 4rpx 10rpx rgba(22, 119, 255, 0.12);
}

.input-label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  height: 100%;
  background-color: transparent;
  outline: none;
  color: #333;
}

.input-field::placeholder {
  color: #bbb;
}

/* 密码提示文字 */
.password-hint {
  font-size: 26rpx;
  color: #007aff;
  margin-top: 12rpx;
  text-align: right;
}

/* 按钮（iOS 风格） */
.next-btn {
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  margin-top: 24rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.25);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.next-btn:active {
  transform: scale(0.97);
  box-shadow: 0 3rpx 10rpx rgba(22, 119, 255, 0.35);
}

.next-btn[disabled] {
  background-color: #d7d7d7;
  color: #fff;
  box-shadow: none;
  cursor: not-allowed;
}

/* 固定开柜框 */
/* 固定开柜框（大容器） */
/* 固定开柜框（大容器） */
.locker-box-large {
  margin-top: 48rpx;       /* 调大和上一元素的间距 */
  padding: 40rpx 24rpx;
  border-radius: 28rpx;
  background-color: #f0f7ff;
  border: 1rpx solid #1677ff;
  display: flex;
  flex-direction: column;  
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(22,119,255,0.15);
}

/* 大字体提示 */
.locker-box-text {
  font-size: 48rpx;          
  font-weight: 700;
  color: #1677ff;
  margin-bottom: 24rpx;      
  text-align: center;
}

/* 小按钮 */
.reopen-btn {
  background-color: #ffffff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
  border-radius: 36rpx;
  font-size: 28rpx;
  height: 70rpx;
  width: 200rpx;            
  line-height: 70rpx;
  text-align: center;
  display: flex;             /* ✅ 使用 flex 确保文字垂直水平居中 */
  justify-content: center;   /* 水平居中 */
  align-items: center;       /* 垂直居中 */
  box-shadow: 0 4rpx 10rpx rgba(22,119,255,0.15);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.reopen-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(22,119,255,0.2);
}
