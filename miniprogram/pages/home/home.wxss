/* 全新设计 - 明亮商务风格 */

page {
  height: 100%;
  background: #f8fafc;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
}

/* 顶部文字区 */
.header {
  padding: 60rpx 48rpx 32rpx;
  text-align: left;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #1e3a5f;
  letter-spacing: 6rpx;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  letter-spacing: 3rpx;
  font-weight: 400;
}

/* 主操作区 - 左右并排 */
.action-area {
  flex: 1;
  display: flex;
  flex-direction: row;
  padding: 32rpx 40rpx;
  gap: 24rpx;
}

/* 操作块通用 */
.action-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.action-block:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* 存包 - 白色底+深蓝边 */
.store {
  background: #ffffff;
  border: 2rpx solid #1e3a5f;
}

/* 取包 - 深蓝底 */
.take {
  background: linear-gradient(145deg, #1e3a5f 0%, #2d4a6f 100%);
  border: 2rpx solid #1e3a5f;
}

/* 装饰线 */
.action-line {
  width: 48rpx;
  height: 3rpx;
  margin-bottom: 32rpx;
  border-radius: 2rpx;
}

.store .action-line {
  background: #1e3a5f;
}

.take .action-line {
  background: rgba(255, 255, 255, 0.4);
}

/* 中文大字 */
.action-text {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  margin-bottom: 12rpx;
}

.store .action-text {
  color: #1e3a5f;
}

.take .action-text {
  color: #ffffff;
}

/* 英文小字 */
.action-en {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  margin-bottom: 48rpx;
}

.store .action-en {
  color: #64748b;
}

.take .action-en {
  color: rgba(255, 255, 255, 0.8);
}

/* 箭头 */
.action-arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 400;
  transition: all 0.3s ease;
}

.store .action-arrow {
  background: #1e3a5f;
  color: #ffffff;
}

.take .action-arrow {
  background: rgba(255, 255, 255, 0.9);
  color: #1e3a5f;
}

/* 底部极简导航 */
.bottom-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 40rpx 80rpx 60rpx;
  gap: 48rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  transition: all 0.3s ease;
}

.nav-item:active {
  opacity: 0.7;
}

.nav-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #cbd5e1;
  transition: all 0.3s ease;
}

.nav-item.active .nav-dot {
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #1e3a5f;
}

.nav-text {
  font-size: 26rpx;
  color: #94a3b8;
  letter-spacing: 4rpx;
  font-weight: 400;
}

.nav-item.active .nav-text {
  color: #1e3a5f;
  font-weight: 600;
}

.nav-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e2e8f0;
}
