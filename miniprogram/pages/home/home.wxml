<view class="page">
  <!-- 简洁头部 -->
  <view class="header">
    <text class="title">智能储物服务</text>
    <text class="subtitle">Smart Locker Service</text>
  </view>

  <!-- 极简操作区 - 左右并排 -->
  <view class="action-area">
    <!-- 存包 - 左半边 -->
    <view class="action-block store" bindtap="goStore">
      <view class="action-line"></view>
      <text class="action-text">存包</text>
      <text class="action-en">STORE</text>
      <view class="action-arrow">→</view>
    </view>

    <!-- 取包 - 右半边 -->
    <view class="action-block take" bindtap="goTake">
      <view class="action-line"></view>
      <text class="action-text">取包</text>
      <text class="action-en">PICKUP</text>
      <view class="action-arrow">→</view>
    </view>
  </view>

  <!-- 底部极简导航 -->
  <view class="bottom-nav">
    <view class="nav-item active" bindtap="goHome">
      <view class="nav-dot"></view>
      <text class="nav-text">首页</text>
    </view>
    <view class="nav-divider"></view>
    <view class="nav-item" bindtap="goMine">
      <view class="nav-dot"></view>
      <text class="nav-text">我的</text>
    </view>
  </view>
</view>
