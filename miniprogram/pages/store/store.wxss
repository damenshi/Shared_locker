/* inherit */
/* 遮罩层 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

/* 弹窗主体 */
.modal-container {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  text-align: center;
  animation: fadeIn 0.25s ease-out;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.modal-locker {
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.locker-no {
  font-size: 40rpx;
  font-weight: bold;
  color: #007aff; /* iOS蓝 */
}

.modal-content {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  justify-content: space-around;
}

.btn {
  flex: 1;
  margin: 0 10rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.cancel {
  background: #f5f5f5;
  color: #333;
}

.confirm {
  background: #007aff;
  color: #fff;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
