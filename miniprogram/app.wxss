/* 商务风格全局样式 */
.page { padding: 0; background: #f8fafc; }
.btn { margin-top: 24rpx; border-radius: 4rpx; }
.card { background: #fff; border-radius: 4rpx; padding: 32rpx; box-shadow: 0 2rpx 12rpx rgba(30,58,95,0.06); margin: 24rpx; border: 1rpx solid #e5e7eb; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 12rpx; color: #1e3a5f; }
.label { color: #6b7280; font-size: 26rpx; }
.value { font-size: 30rpx; color: #1f2937; }
.primary { background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%); color:#fff; box-shadow: 0 4rpx 12rpx rgba(30,58,95,0.2); }
.warn { background: #dc2626; color:#fff; }
.link { color: #1e3a5f; }
.row { display:flex; justify-content: space-between; align-items: center; margin: 16rpx 0; }
.small { font-size:26rpx; color:#6b7280; }
